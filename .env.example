# Pasito Environment Variables

# =============================================================================
# SUPABASE
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# EVENT TICKETING
# =============================================================================
# Signing secret for QR codes and checkout intents
EVENT_TICKET_SIGNING_SECRET=random-256-bit-secret

# =============================================================================
# PAYMENT PROVIDERS
# =============================================================================

# Rebill (for Argentina events like Tomate)
# Consumer checkouts (tienda, club, entradas) use the no-IVA account first.
NEXT_PUBLIC_REBILL_NO_IVA_PUBLIC_KEY=pk_live_no_iva_...
REBILL_NO_IVA_SECRET_KEY=sk_live_no_iva_...
NEXT_PUBLIC_REBILL_PUBLIC_KEY=pk_live_...
REBILL_SECRET_KEY=sk_live_...
REBILL_LEGACY_SECRET_KEY=sk_live_legacy_...
REBILL_WEBHOOK_SECRET=whsec_...
REBILL_NEW_WEBHOOK_SECRET=whsec_new_...

# dLocal Go (for Uruguay Walking Club event)
# Get credentials from: https://dashboard.dlocalgo.com (production) or https://dashboard-sbx.dlocalgo.com (sandbox)
DLOCALGO_API_KEY=your-api-key-here
DLOCALGO_SECRET_KEY=your-secret-key-here
DLOCALGO_WEBHOOK_SECRET=your-webhook-secret-here

# Silver Rebill (dedicated keys for Silver event)
NEXT_PUBLIC_SILVER_REBILL_PUBLIC_KEY=pk_live_...
SILVER_REBILL_SECRET_KEY=sk_live_...
SILVER_REBILL_WEBHOOK_SECRET=whsec_...

# =============================================================================
# EMAIL
# =============================================================================
RESEND_API_KEY=re_...

# =============================================================================
# OTHER
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://pasito.app
NODE_ENV=production
